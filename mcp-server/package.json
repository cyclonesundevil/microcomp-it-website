{
  "name": "microcompit-cyberlab-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "copy:engine": "node scripts/copy-engine.mjs",
    "dev": "npm run copy:engine && tsx watch src/index.ts",
    "build": "npm run copy:engine && tsc",
    "start": "node dist/index.js",
    "pretest": "npm run copy:engine",
    "test": "vitest run",
    "typecheck": "npm run copy:engine && tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test:client": "tsx scripts/test-client.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "dotenv": "^17.4.2",
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^20.19.33",
    "@types/supertest": "6.0.3",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
