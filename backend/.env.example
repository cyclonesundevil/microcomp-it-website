GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
DISCORD_WEBHOOK_URL="YOUR_DISCORD_WEBHOOK_URL_HERE"

# Optional email delivery for contact form notifications.
# For Gmail, use a Google App Password, not your normal Gmail password.
SMTP_EMAIL="your-sender@gmail.com"
SMTP_PASSWORD="your-google-app-password"
CONTACT_EMAIL_RECEIVER="your-lead-inbox@example.com"
# Public origin used to build one-time contact verification links.
CONTACT_PUBLIC_BASE_URL="https://your-domain.example"

# Optional Cloudflare Turnstile protection for contact submissions and chat starts.
# Create a managed widget for the production hostname. Leave both blank to disable locally.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Optional separate random value used to sign the four-hour chat verification cookie.
TURNSTILE_SIGNING_SECRET=""

# Optional persistent analytics database path.
# On Render, set this to a mounted persistent disk path such as /data/analytics.db.
ANALYTICS_DB_PATH="/data/analytics.db"

# Optional Google Map Tiles API browser key for the Universe Explorer Earth Surface mode.
GOOGLE_MAPS_TILE_API_KEY=""

# Optional analytics IP geolocation.
# Leave unset to avoid third-party lookups. If set, new public IP hits can include city/region/country/timezone.
# Option 1: ipinfo.io token
IPINFO_TOKEN=""
# Option 2: custom lookup URL with {ip}, for example: https://ipapi.co/{ip}/json/
ANALYTICS_GEO_LOOKUP_URL=""
